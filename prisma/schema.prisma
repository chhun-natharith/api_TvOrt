// Prisma schema
// Docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  ACTIVE
  INACTIVE
}

// The enums below are lowercase on purpose: their values are the same keys the
// TvOrt frontend uses for its type unions and label lookups (e.g. t.interests["temples"]).
enum Interest {
  temples
  beaches
  nature
  city
  food
  culture
}

enum FoodType {
  dish
  street
  spot
}

enum PlaceCategory {
  nature
  business
  experience
}

enum CostCategory {
  transport
  stay
  food
  activities
}

model User {
  id             Int        @id @default(autoincrement())
  name           String
  email          String     @unique
  password       String
  /// Avatar file; cleared automatically when the media row is deleted
  profileImageId String?    @unique
  profileImage   Media?     @relation("UserProfileImage", fields: [profileImageId], references: [id], onDelete: SetNull)
  status         UserStatus @default(ACTIVE)
  roleId         Int?
  role           Role?      @relation(fields: [roleId], references: [id])
  media          Media[]    @relation("MediaUploader")
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  @@index([roleId])
  @@map("users")
}

model Role {
  id          Int              @id @default(autoincrement())
  name        String           @unique
  description String?
  users       User[]
  permissions RolePermission[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@map("roles")
}

model Permission {
  id          String           @id @default(uuid())
  name        String           @unique
  description String?
  roles       RolePermission[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@map("permissions")
}

model RolePermission {
  roleId       Int
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now())

  @@id([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
}

model RefreshToken {
  id        String    @id @default(uuid())
  userId    Int
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@map("refresh_tokens")
}

model Media {
  id           String   @id @default(uuid())
  filename     String
  originalName String
  mimeType     String
  size         Int
  key          String   @unique
  url          String
  bucket       String
  provider     String   @default("S3")
  uploaderId   Int?
  uploader     User?    @relation("MediaUploader", fields: [uploaderId], references: [id], onDelete: SetNull)
  profileOf    User?    @relation("UserProfileImage")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([uploaderId])
  @@map("media")
}

// ─── Travel content ──────────────────────────────────────────────────────────
// Every `Json` column marked "localized" holds `{ "en": string, "kh"?: string }`,
// the same shape as the frontend's `Text` type, so `tx(value, locale)` works unchanged.
// Public URLs use `slug`; `sortOrder` is the display order (lower first).

model Province {
  id               String              @id @default(uuid())
  slug             String              @unique
  name             Json // localized
  tagline          Json // localized
  image            String
  interests        Interest[]
  whyGo            Json // localized
  bestSeasonMonths Json // localized
  bestSeasonDetail Json // localized
  goodToKnow       Json? // localized
  // Sample budget, USD per person per day
  budgetStay       Decimal             @db.Decimal(10, 2)
  budgetFood       Decimal             @db.Decimal(10, 2)
  budgetTransport  Decimal             @db.Decimal(10, 2)
  budgetActivities Decimal             @db.Decimal(10, 2)
  budgetNote       Json // localized
  sortOrder        Int                 @default(0)
  topPlaces        ProvinceTopPlace[]
  gettingThere     ProvinceTransport[]
  foods            Food[]
  hiddenPlaces     HiddenPlace[]
  plans            BudgetPlan[]
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  @@map("provinces")
}

model ProvinceTopPlace {
  id          String   @id @default(uuid())
  provinceId  String
  province    Province @relation(fields: [provinceId], references: [id], onDelete: Cascade)
  name        Json // localized
  description Json // localized
  image       String
  sortOrder   Int      @default(0)

  @@index([provinceId])
  @@map("province_top_places")
}

model ProvinceTransport {
  id         String   @id @default(uuid())
  provinceId String
  province   Province @relation(fields: [provinceId], references: [id], onDelete: Cascade)
  mode       Json // localized
  detail     Json // localized
  sortOrder  Int      @default(0)

  @@index([provinceId])
  @@map("province_transports")
}

/// "Coming soon" teasers shown under the destinations list. Promote one by
/// creating a Province and deleting the teaser.
model UpcomingProvince {
  id        String     @id @default(uuid())
  name      Json // localized
  image     String
  interests Interest[]
  sortOrder Int        @default(0)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@map("upcoming_provinces")
}

model Food {
  id            String      @id @default(uuid())
  slug          String      @unique
  name          Json // localized
  khmerName     String
  pronunciation String
  type          FoodType
  image         String
  summary       Json // localized
  whatItIs      Json // localized
  priceMin      Decimal     @db.Decimal(10, 2)
  priceMax      Decimal     @db.Decimal(10, 2)
  priceUnit     Json // localized, e.g. "per plate"
  sortOrder     Int         @default(0)
  provinces     Province[]
  venues        FoodVenue[]
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([type])
  @@map("foods")
}

/// "Where to try it" entries on a food's page.
model FoodVenue {
  id        String @id @default(uuid())
  foodId    String
  food      Food   @relation(fields: [foodId], references: [id], onDelete: Cascade)
  name      Json // localized
  detail    Json // localized
  sortOrder Int    @default(0)

  @@index([foodId])
  @@map("food_venues")
}

model HiddenPlace {
  id         String        @id @default(uuid())
  slug       String        @unique
  name       Json // localized
  khmerName  String?
  provinceId String
  province   Province      @relation(fields: [provinceId], references: [id])
  category   PlaceCategory
  /// Ordered; the first image is the cover.
  images     String[]
  summary    Json // localized
  special    Json // localized
  howToReach Json // localized
  costMin    Decimal       @db.Decimal(10, 2)
  costMax    Decimal       @db.Decimal(10, 2)
  costNote   Json // localized
  bestTime   Json // localized
  sortOrder  Int           @default(0)
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  @@index([provinceId])
  @@index([category])
  @@map("hidden_places")
}

model BudgetPlan {
  id         String           @id @default(uuid())
  slug       String           @unique
  title      Json // localized
  provinceId String
  province   Province         @relation(fields: [provinceId], references: [id])
  image      String
  days       Int
  people     Int
  summary    Json // localized
  /// Array of localized strings.
  tips       Json
  sortOrder  Int              @default(0)
  costs      BudgetPlanCost[]
  outline    BudgetPlanDay[]
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  @@index([provinceId])
  @@map("budget_plans")
}

model BudgetPlanCost {
  id        String       @id @default(uuid())
  planId    String
  plan      BudgetPlan   @relation(fields: [planId], references: [id], onDelete: Cascade)
  category  CostCategory
  label     Json // localized
  amount    Decimal      @db.Decimal(10, 2)
  sortOrder Int          @default(0)

  @@index([planId])
  @@map("budget_plan_costs")
}

/// One day of a plan's itinerary. Day number = position by sortOrder.
model BudgetPlanDay {
  id        String     @id @default(uuid())
  planId    String
  plan      BudgetPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  title     Json // localized
  /// Array of localized strings.
  items     Json
  sortOrder Int        @default(0)

  @@index([planId])
  @@map("budget_plan_days")
}

// ─── Visitor submissions (written by the public site, read by staff) ─────────

model NewsletterSubscriber {
  id        String   @id @default(uuid())
  email     String   @unique // stored lowercase
  createdAt DateTime @default(now())

  @@map("newsletter_subscribers")
}

model ContactMessage {
  id        String    @id @default(uuid())
  name      String
  email     String
  message   String
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([createdAt])
  @@map("contact_messages")
}
