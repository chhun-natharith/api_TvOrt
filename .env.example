# Application
NODE_ENV=development
PORT=8200
CORS_ORIGIN=http://localhost:3000,http://localhost:5173

# Database
DATABASE_URL="postgresql://user:password@localhost:5432/inventory?schema=public"

# JWT
JWT_ACCESS_SECRET=change-me-access
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change-me-refresh
JWT_REFRESH_EXPIRES_IN=7d

# File storage (avatars + /media uploads)
# Leave the access keys empty to store files on local disk under ./uploads
# (served at /uploads). Set them in production — local files are lost when
# the container is replaced.
# S3 | R2 | MINIO
STORAGE_PROVIDER=S3
STORAGE_BUCKET=tvort-media
STORAGE_REGION=ap-southeast-1
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
# R2/MinIO only: the S3 API endpoint, e.g. http://localhost:9000
STORAGE_ENDPOINT=
STORAGE_FORCE_PATH_STYLE=false
# Public base URL for stored files (CDN or bucket domain). Without it, S3 URLs
# are https://<bucket>.s3.<region>.amazonaws.com/<key>; the bucket (or CDN)
# must allow public reads for those URLs to load.
STORAGE_PUBLIC_URL=
